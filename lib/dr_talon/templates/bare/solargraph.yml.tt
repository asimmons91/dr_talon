---
include:
  - "mygame/**/*.rb"
exclude:
  - "mygame/tmp/**/*"
require: []
domains: []
reporters:
  - rubocop
formatter:
  rubocop:
    cops: safe
    except: []
    only: []
    extra_args: []
type_checker:
  rules: {}
require_paths: []
plugins:
  - solargraph-dragonruby
<% if talon? -%>
  - solargraph-dr_talon
<% end -%>
max_files: 5000
